<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectName>HAres</ProjectName>
    <RootNamespace>HAres</RootNamespace>
    <ProjectGuid>{8A2C5F31-4B7E-4D2A-9E63-1C5D7A9B0E42}</ProjectGuid>
    <VCProjectVersion>15.0</VCProjectVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ShowAllFiles>true</ShowAllFiles>
    <ThisDir>$(MSBuildThisFileDirectory)</ThisDir>
    <YRppDir>$(ThisDir)YRpp</YRppDir>
  </PropertyGroup>
  <!-- Import props: HAres.props first (compiler/linker settings), then YRpp.props
       which pulls in YRpp\StaticInits.cpp and all YRpp headers. -->
  <Import Project="$(ThisDir)\HAres.props" />
  <Import Project="$(YRppDir)\YRpp.props" />
  <!-- Resource files -->
  <ItemGroup>
    <ResourceCompile Include="src\version.rc" />
  </ItemGroup>
  <!-- Compiled files. Add every new .cpp here or it will not be compiled. -->
  <ItemGroup>
    <ClCompile Include="src\HAres.cpp" />
    <ClCompile Include="src\Misc\AresUnitSuperWeapon.cpp" />
    <ClCompile Include="src\Misc\Hooks.Demo.cpp" />
    <ClCompile Include="src\Misc\UnitSuperWeapon.cpp" />
    <ClCompile Include="src\Utilities\Debug.cpp" />
    <ClCompile Include="src\Utilities\Patch.cpp" />
  </ItemGroup>
  <!-- Header files (for IDE navigation only; not required to build) -->
  <ItemGroup>
    <ClInclude Include="src\HAres.h" />
    <ClInclude Include="src\HAres.version.h" />
    <ClInclude Include="src\Misc\UnitSuperWeapon.h" />
    <ClInclude Include="src\Utilities\Debug.h" />
    <ClInclude Include="src\Utilities\Macro.h" />
    <ClInclude Include="src\Utilities\Patch.h" />
  </ItemGroup>
</Project>
